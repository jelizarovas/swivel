<Window x:Class="Swivel.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swivel rotation"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        Opacity="0"
        SourceInitialized="Window_SourceInitialized">
    <Grid Background="Transparent" Margin="18">
        <Border x:Name="BubbleSurface"
                Background="#F21A202B"
                BorderBrush="#667A98C8"
                BorderThickness="1"
                CornerRadius="28"
                Padding="12"
                MouseEnter="BubbleSurface_MouseEnter"
                MouseLeave="BubbleSurface_MouseLeave"
                PreviewTouchDown="BubbleSurface_TouchDown"
                PreviewTouchUp="BubbleSurface_TouchUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Opacity="0.48"
                                  Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RotateButton"
                            Grid.Column="0"
                            Width="272"
                            Height="92"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="RotateButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⟳"
                                       FontSize="42"
                                       FontWeight="Normal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="10,0,8,0">
                                <TextBlock Text="Rotate display"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="TargetText"
                                           Text="Switch orientation"
                                           Foreground="#E2E8FF"
                                           FontSize="13"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Width="96"
                            Height="92"
                            Content="Settings"
                            Click="SettingsButton_Click" />
                </Grid>
                <TextBlock x:Name="StatusText"
                           Text="Touch the reader again to close"
                           Foreground="#A8B5C8"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="8,9,8,5" />
                <ProgressBar x:Name="DismissProgress"
                             Height="3"
                             Minimum="0"
                             Maximum="1"
                             Value="1"
                             Foreground="#8FA6FF"
                             Background="#263246"
                             BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
