<Window x:Class="Swivel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swivel"
        Width="760"
        Height="840"
        MinWidth="680"
        MinHeight="680"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceItemTemplate">
            <TextBlock Text="{Binding Label}"
                       Foreground="#111827" />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <Grid Margin="2,0,2,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Swivel"
                                   FontSize="34"
                                   FontWeight="Bold" />
                        <TextBlock Text="A tiny rotation control for your Surface Hub"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#18253A"
                            BorderBrush="#304766"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <TextBlock Text="PROTOTYPE 0.1"
                                   Foreground="#AFC5FF"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Fingerprint reader"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="FingerprintStatusDot"
                                     Width="12"
                                     Height="12"
                                     Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Top"
                                     Margin="0,5,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="FingerprintStatusText"
                                           Text="Starting the reader probe…"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Swivel receives only an unused-scan signal; it never reads or stores a fingerprint."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           Margin="0,5,18,0" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="Retry"
                                    Click="RetryReader_Click"
                                    VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Test it here"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Your current computer can simulate the Hub reader. One trigger shows the bubble; another trigger hides it."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Simulate fingerprint touch"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SimulateTouch_Click" />
                            <Button Grid.Column="2"
                                    Content="Hide to notification area"
                                    Click="Hide_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bubble behavior"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="The countdown pauses while the bubble is being touched."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="DismissDelayValueText"
                                       Grid.Column="1"
                                       Foreground="#BFD0FF"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="DismissDelaySlider"
                                Minimum="0.5"
                                Maximum="10"
                                TickFrequency="0.5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DismissDelaySlider_ValueChanged"
                                Margin="0,18,0,14" />
                        <CheckBox x:Name="ShowSettingsButtonCheckBox"
                                  Content="Show the Settings button inside the rotation bubble" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Placement and direction"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Landscape bubble"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,7" />
                                <ComboBox x:Name="LandscapePositionCombo"
                                          ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Portrait bubble"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,7" />
                                <ComboBox x:Name="PortraitPositionCombo"
                                          ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="How the panel turns into portrait"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,7" />
                            <ComboBox x:Name="PortraitTurnCombo"
                                      ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                      SelectedValuePath="Value" />
                        </StackPanel>
                        <Border Background="#10151E"
                                BorderBrush="#252E3C"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,16,0,0">
                            <TextBlock x:Name="DisplayStatusText"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Startup"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <CheckBox x:Name="LaunchAtSignInCheckBox"
                                  Content="Launch Swivel automatically when I sign in"
                                  Margin="0,14,0,0" />
                        <TextBlock Text="Enable this on the Hub only after the reader and rotation tests pass. Keep the EXE in its permanent folder before enabling it."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diagnostics"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Copy log path"
                                    Click="CopyLogPath_Click"
                                    Padding="12,7" />
                        </Grid>
                        <TextBox x:Name="DiagnosticsTextBox"
                                 Height="140"
                                 Margin="0,14,0,0"
                                 Padding="12"
                                 Background="#0A0D12"
                                 Foreground="#B9C5D6"
                                 BorderBrush="#252E3C"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SaveStatusText"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="3,0,0,10" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Save settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click" />
                    <Button Grid.Column="2"
                            Content="Hide"
                            Click="Hide_Click" />
                    <Button Grid.Column="4"
                            Content="Exit Swivel"
                            Click="Exit_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
